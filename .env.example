# Copy to .env (gitignored) or export in your shell. Never commit real values.
# Kaggle: the new API token (preferred) ...
KAGGLE_API_TOKEN=
# ... or the legacy kaggle.json pair
KAGGLE_USERNAME=
KAGGLE_KEY=
# Optional: which exported model wafer.infer serves by default (else models/v1, then models/v0)
WAFER_MODEL_DIR=
# Classifier backend for the agent / score_stream (cnn default; yolo is not available yet)
WAFER_CLASSIFIER=cnn
# AMD Token Factory (OpenAI-compatible). List models via GET $AMD_BASE_URL/models — do not guess IDs.
AMD_API_KEY=
AMD_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
AMD_MODEL=
# Optional legacy alias for the key only (prefer AMD_API_KEY):
# RADEON_API_KEY=
